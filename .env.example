# Return an ordered JSON array of gallery photos (or { "photos": [...] }).
VITE_GALLERY_URL=

# Accept POST JSON { name, email, message, locale, captchaToken } and return 2xx only after server-side verification and acceptance.
VITE_CONTACT_URL=

# Public Cloudflare Turnstile site key (never put the secret in a VITE_ variable).
VITE_TURNSTILE_SITE_KEY=
